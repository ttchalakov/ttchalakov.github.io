@techreport{tchalakov2024riss,
  preview         = {riss2024_planned_trajectory.png},
  abbr            = {RISS},
  title           = {Slack Convex Feasible Set Trajectory Optimizer},
  author          = {Tchalakov, Teodor and Liu, Simin and Liu, Changliu and Dolan, John M.},
  institution     = {Carnegie Mellon University},
  howpublished    = {Working paper, Robotics Institute Summer Scholars (RISS), Carnegie Mellon University},
  year            = {2024},
  abstract        = {Trajectory planners are a fundamental robotics tool where often highly nonlinear and non-convex problems are formulated to solve for high-quality trajectories with respect to nonlinear system dynamics, obstacle avoidance, and other general constraints. The optimization-based trajectory planning approach seeks to find locally optimal trajectories in real time that are feasible. The Slack Convex Feasible Set (SCFS) algorithm was proposed to handle non-convex inequality and nonlinear dynamics equality constraints in real time by convexification. We present SCFS as a general purpose kinodynamic trajectory optimizer and derive a new convexification method for compact non-convex feasible sets. However, we observe that for problems with large negative Hessian eigenvalues and small feasible regions, the convergence rate and initialization robustness of SCFS suffer significantly. We demonstrate methods to improve initialization robustness and assess methods for improving convergence rates on a dynamic conveyor picking problem.},
  pdf             = {https://drive.google.com/file/d/1MF4IeeKGDPu_Kf8SvMHMcCCTrT23V42T/view},
  poster          = {https://drive.google.com/file/d/132OaCRNWRFeCMU756vzG8gZoF_94bIng/view},
  video           = {https://www.youtube.com/watch?v=_wilJbJ5Pbg},
  bibtex_show     = {true}
}

@techreport{tchalakov2022riss,
  preview         = {riss2022_bounding_sivia.png},
  abbr            = {RISS},
  title           = {Guaranteed Parameter Uncertainty Estimation Using Interval Analysis for Robust Safety-Critical Control},
  author          = {Tchalakov, Teodor and Lin, Qin and Dolan, John M.},
  institution     = {Carnegie Mellon University},
  howpublished    = {Robotics Institute Summer Scholars Working Papers Journal, vol. 10, Carnegie Mellon University},
  year            = {2022},
  pages           = {211--216},
  abstract        = {Robust control Lyapunov functions (CLFs) and control barrier functions (CBFs) use the largest bounds of parameter uncertainties to achieve robust safety-critical control, but the literature has proposed the bounds be manually tuned. This tuning problem requires balancing large uncertainty bounds in robust controllers that produce aggressive behavior against small uncertainty bounds that violate robustness. We present an over-approximate model parameter uncertainty estimation method for applications in robust CLF-CBF quadratic programming (QP) controllers using interval analysis. This work expands upon the set inversion via interval analysis (SIVIA) algorithm, which can be used offline to find bounds on parameter uncertainties from system observations. We improve the efficiency of SIVIA for finding the largest verified parameter intervals with an over-approximate heuristic search that uses system identification to provide initial guesses. The identification of model uncertainties can enable the lifelong operation of robust safety-critical systems. We test our approach's accuracy and efficiency in comparison to SIVIA on an adaptive cruise control scenario with a robust CLF-CBF-QP controller.},
  pdf             = {https://riss.ri.cmu.edu/wp-content/uploads/2023/08/CMU-RISS_Working_Papers_Journal-2022-PAPERS.pdf#page=211},
  poster          = {https://drive.google.com/file/d/1ugYz2jrBpqnbVOB5iHVibSP-EJItBtDZ/view},
  video           = {https://www.youtube.com/watch?v=8FX27eK2ldw},
  bibtex_show     = {true}
}
