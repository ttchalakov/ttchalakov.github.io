@unpublished{taskentropy2026,
  title       = {Task Entropy for Low Bitrate Robot Control: Minimal data rate controller for a nano-drone},
  author      = {Tchalakov, Teodor and Mitra, Sayan},
  year        = {2026},
  abbr        = {Under review},
  preview     = {hscc_flight.jpg},
  abstract    = {Low bitrate robot control requires knowing how much feedback information a task demands. Reachability entropy answers this for reaching a fixed target set, but visiting locations in order or returning to the start depends on the execution history, since one physical state can occur at different task stages. We introduce task entropy for tasks given as labels on executions, extending reachability entropy to history-dependent tasks with no automaton fixed in advance. For set-valued dynamics with full-state observations, we prove that it equals the least worst-case average data rate of coder–controllers guaranteeing completion. We learn a coder–controller that refines the set of states consistent with the sent symbols only when needed. On two history-dependent nano-drone tasks it reduces the maximum bit count 2.3 to 5.6 times relative to a fixed-grid coder in simulation, and Crazyflie nano-drone flights demonstrate the communication scheme on hardware.}
}

@inproceedings{yuceel2026minimal,
  preview     = {cdc_vq_partition.png},
  title       = {Minimal Information Control Invariance via Vector Quantization},
  author      = {Yuceel, Ege and Tchalakov, Teodor and Mitra, Sayan},
  booktitle   = {IEEE Conference on Decision and Control (CDC)},
  year        = {2026},
  note        = {To appear},
  abbr        = {CDC},
  arxiv       = {2604.03132},
  abstract    = {Safety-critical autonomous systems must satisfy hard state constraints under tight computational and sensing budgets, yet learning-based controllers are often far more complex than safe operation requires. To formalize this gap, we study how many distinct control signals are needed to render a compact set forward invariant under sampled-data control, connecting the question to the information-theoretic notion of invariance entropy. We propose a vector-quantized autoencoder that jointly learns a state-space partition and a finite control codebook, and develop an iterative forward certification algorithm that uses Lipschitz-based reachable-set enclosures and sum-of-squares programming. On a 12-dimensional nonlinear quadrotor model, the learned controller achieves a 157× reduction in codebook size over a uniform grid baseline while preserving invariance, and we empirically characterize the minimum sensing resolution compatible with safe operation.},
  bibtex_show = {true},
  selected    = {true}
}

